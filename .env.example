# Local API (keeps auth, PDF streaming, and Google OAuth on the backend)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SOCKET_URL=http://localhost:8080

# Cloudflare official always-pass Turnstile dummy sitekey for local development only.
# Pair it only with the matching test secret in the backend .env.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Vite proxy target for relative /api, /uploads, and /socket.io requests.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
