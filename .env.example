# Copy to universiyfrontend/.env.local. Vite loads frontend env files from this
# directory; only VITE_-prefixed values are exposed to browser code.

# Local API (keeps auth, PDF streaming, and Google OAuth on the backend)
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Legacy API URL alias; VITE_API_BASE_URL takes precedence.
VITE_API_URL=
VITE_SOCKET_URL=http://localhost:8080
# Legacy socket URL alias.
VITE_API_SERVER_URL=

# The backend accepts this bypass only when it is also enabled in
# backendunic/.env, the browser hostname is local, and the request Origin
# exactly matches a localhost origin in backend ALLOWED_ORIGINS.
VITE_TURNSTILE_DEV_BYPASS=true
# Required for normal/production Turnstile. Leave blank only while the local
# development bypass is explicitly enabled on both frontend and backend.
VITE_TURNSTILE_SITE_KEY=

# Vite proxy target for relative /api, /uploads, and /socket.io requests.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Public Google OAuth client ID for browser-based Google One Tap.
VITE_GOOGLE_CLIENT_ID=

# Optional Firebase browser config for push notifications.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Optional terminal UI feature flag. Backend execution support must also be configured.
VITE_ENABLE_LINUX_TERMINAL=false

# Optional WebRTC TURN relay for meetings; STUN-only is used when unset.
# These values are shipped to browsers. Use short-lived/rotated TURN credentials,
# never a long-lived infrastructure password.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
